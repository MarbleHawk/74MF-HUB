-- Dragging Logic
local UserInputService = game:GetService("UserInputService")
local dragging, dragStart, startPos
frame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		startPos = frame.Position
	end
end)
UserInputService.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart
		frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)
UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
end)

-- Spoofer Logic
local function spoofLoop()
	local remote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("GenericFunction")
	
	while enabled do
		for _, typeName in ipairs(grassTypes) do
			if not enabled then break end
			
			status.Text = "Spoofing: " .. typeName
			
			local args = {
				{
					id = "cut",
					identifier = typeName,
					quantity = 1, -- Trying to spoof massive quantities
					field = "main"
				}
			}
			
			-- Use task.spawn so the script doesn't freeze waiting for the server to reply
			task.spawn(function()
				pcall(function()
					remote:InvokeServer(unpack(args))
				end)
			end)
			
			task.wait(0.1) -- 0.1 second delay between each cut to prevent server disconnects
		end
	end
	status.Text = "Status: Waiting..."
end

