local function getNPCList()
	local g = (getgenv and getgenv()) or _G
	local mobname = g.mobname
	if type(mobname) ~= "string" or mobname == "" then
		return nil
	end
	local dist, thing = math.huge, nil
	local char = game.Players.LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return nil
	end
	for _, v in ipairs(enemiesFolder:GetDescendants()) do
		if v:IsA("Part") and v.Name == mobname then
			local mag = (hrp.Position - v.Position).Magnitude
			if mag < dist then
				dist = mag
				thing = v
			end
		end
	end
	return thing
end

