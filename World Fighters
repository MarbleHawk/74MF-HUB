})

local function getNPCList()
    local dist, thing = math.huge, nil
    for i, v in pairs(game:GetService("Workspace").Server.Enemies:GetDescendants()) do
        if v:IsA("Part") and v.Name == mobname then
            local mag = (game.Players.LocalPlayer.Character.HumanoidRootPart.Position - v.Position).Magnitude
            if mag < dist then
                dist = mag
                thing = v
            end
        end
    end
    return thing
end

