local function getNPC()
    local dist, thing = math.huge, nil
    for i, v in pairs(game:GetService("Workspace").Server.Enemies:GetDescendants()) do
        if v:IsA("Part") then
            local char = game.Players.LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local mag = (char.HumanoidRootPart.Position - v.Position).Magnitude
                if mag < dist then
                    dist = mag
                    thing = v
                end
            end
        end
    end
    return thing
end

local function getNPCNEAR()
    local dist, thing = math.huge, nil
    for i, v in pairs(game:GetService("Workspace").Client:GetDescendants()) do
        if v:IsA("Model") and v.Parent.Name == "Enemies" then
            local char = game.Players.LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local mag = (char.HumanoidRootPart.Position - v.HumanoidRootPart.Position).Magnitude
