local function getNPC()
	local dist, thing = math.huge, nil
	for _, v in ipairs(enemiesFolder:GetDescendants()) do
		if v:IsA("Part") then
			local char = game.Players.LocalPlayer.Character
			if char and char:FindFirstChild("HumanoidRootPart") then
				local mag = (char.HumanoidRootPart.Position - v.Position).Magnitude
				if mag < dist then
					dist = mag
					thing = v
				end
			end
		end
	end
	return thing
end

local function getNPCNEAR()
	local dist, thing = math.huge, nil
	local client = Workspace:FindFirstChild("Client")
	if not client then
		return nil
	end
	for _, v in ipairs(client:GetDescendants()) do
		if v:IsA("Model") and v.Parent and v.Parent.Name == "Enemies" then
			local char = game.Players.LocalPlayer.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local mobHrp = v:FindFirstChild("HumanoidRootPart")
			if hrp and mobHrp then
				local mag = (hrp.Position - mobHrp.Position).Magnitude
				if mag < dist then
					dist = mag
					thing = v
				end
			end
		end
	end
	return thing
end

local function getORE()
	local dist, thing = math.huge, nil
	local oresRoot = enemiesFolder:FindFirstChild("Ores")
	if not oresRoot then
		return nil
	end
	for _, v in ipairs(oresRoot:GetDescendants()) do
		if v:IsA("Part") then
			local char = game.Players.LocalPlayer.Character
			if char and char:FindFirstChild("HumanoidRootPart") then
				local mag = (char.HumanoidRootPart.Position - v.Position).Magnitude
				if mag < dist then
					dist = mag
					thing = v
				end
			end
		end
	end
	return thing
end

