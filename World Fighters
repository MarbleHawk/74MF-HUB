local Workspace = game:GetService("Workspace")
local Server = Workspace:FindFirstChild("Server")
local enemiesFolder = Server and Server:FindFirstChild("Enemies")
if not enemiesFolder then
	warn("[74MF] World Fighters: Workspace.Server.Enemies not found (join World Fighters).")
	return
end

local NPCS = {}

for _, v in ipairs(enemiesFolder:GetDescendants()) do
	if v:IsA("Part") then
		if not table.find(NPCS, tostring(v)) then
			table.insert(NPCS, tostring(v))
		end
	end
end

