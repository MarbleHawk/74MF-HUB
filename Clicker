-- Roll N unique pets from the egg's list. Uses weighted rolls (rollPetFromList) and re-
-- rolls duplicates up to a limit; falls back to scanning the list if rerolls exhaust.
local function rollUniquePets(list, n)
	local result = {}
	local seen = {}
	local rerollLimit = 40
	for i = 1, n do
		local picked = nil
		for _ = 1, rerollLimit do
			local p = rollPetFromList(list)
			if not seen[p.name] then
				seen[p.name] = true
				picked = p
				break
			end
		end
		if not picked then
			-- Fallback (shouldn't normally hit this): pick the first pet not yet seen.
			for _, p in ipairs(list) do
				if not seen[p.name] then
					seen[p.name] = true
					picked = p
					break
				end
			end
		end
		result[i] = picked
	end
	return result
end

-- Wrap a hatch roll so the click handler can reuse it for both the 1x and 3x buttons.
local function performHatchClick(capDef, rollCount)
	-- Per-egg cooldown gate (configurable via the cooldown upgrade in upgrades tab).
	local remaining = FX.getEggRemainingCooldown(capDef.id)
	if remaining > 0 then
		showNotification(
			string.format("\u{23F1}\u{FE0F} %s on cooldown (%.1fs)", capDef.name, remaining),
			Color3.fromRGB(80, 60, 110)
		)
		return
	end
	if not AREAS.unlocked[capDef.areaIndex] then
		showNotification(
			"\u{1F512} Unlock "
				.. (AREAS.NAMES[capDef.areaIndex] or ("area " .. tostring(capDef.areaIndex)))
				.. " first.",
			Color3.fromRGB(120, 50, 70)
		)
		return
	end
	-- 3x rolls 3 unique pets (no duplicates) for 3× the click cost; 5x rolls 5 for
	-- 5×. Each tier requires its own upgrade to be unlocked — fall back to 1x if the
	-- player somehow requests a tier they haven't bought.
	local n = math.max(1, rollCount or 1)
	if n >= 5 and not FX.fiveHatchUnlocked then
		n = FX.tripleHatchUnlocked and 3 or 1
	end
	if n >= 3 and n < 5 and not FX.tripleHatchUnlocked then
		n = 1
	end
	local totalCost = capDef.cost * n
	if clicks < totalCost then
		showNotification(
			"Need " .. formatNumber(totalCost) .. " clicks for " .. capDef.name,
			Color3.fromRGB(40, 30, 60)
		)
		return
	end
	local pets = (n == 1) and { rollPetFromList(capDef.list) } or rollUniquePets(capDef.list, n)

	-- Pre-decide auto-delete + shiny per pet so the storage / inventory-full check is
	-- accurate (auto-deleted rolls bypass the cap).
	local rolled = {}
	local needsStorage = 0
	for i = 1, n do
		local pet = pets[i]
		local autoDel = shouldAutoDelete(capDef.id, pet.rarity)
		local shiny = (not autoDel) and FX.rollIsShiny() or false
		rolled[i] = { pet = pet, autoDel = autoDel, shiny = shiny }
		if not autoDel then
			needsStorage = needsStorage + 1
		end
	end
	if needsStorage > 0 and getTotalPetCount() + needsStorage > getPetStorageCap() then
		showNotification(
			"\u{1F4E6} Inventory is full! Sell or delete pets to make room.",
			Color3.fromRGB(80, 30, 30)
		)
		return
	end

	clicks = clicks - totalCost
	eggsHatched = eggsHatched + n
	-- v42: single global cooldown — every hatch cools every egg.
	FX.lastHatchTick = os.clock()

	local autoDelCount = 0
	local autoDelRefundGems = 0
	-- v29: collect all non-auto-deleted pets into a single *batch* so a triple-hatch
	-- shows three popups side-by-side (center + left + right) instead of one at a time.
	local batch = {}
	-- v50: cache the refund pct once per hatch — it never changes mid-batch.
	local refundPct = FX.getAutoDelRefundPct()
	for _, entry in ipairs(rolled) do
		if entry.autoDel then
			autoDelCount = autoDelCount + 1
			totalPetsDeleted = totalPetsDeleted + 1
			-- v50: even auto-deleted hatches now refund a fraction of what the
			-- pet *would* have paid out in 💎. Tracked separately so we can show
			-- a single "+X 💎 refunded" line on the notification.
			local refund = math.floor(FX.gemsFromHatch(capDef.cost, entry.pet.rarity) * refundPct + 0.5)
			if refund > 0 then
				gems = gems + refund
				lifetimeGems = lifetimeGems + refund
				autoDelRefundGems = autoDelRefundGems + refund
			end
		else
			local key = entry.shiny and shinyKey(entry.pet.name) or entry.pet.name
			local ht = invGetOrCreate(key)
			ht.c = ht.c + 1
			local gRoll = FX.gemsFromHatch(capDef.cost, entry.pet.rarity)
			gems = gems + gRoll
			lifetimeGems = lifetimeGems + gRoll
			local subline = string.format(
				"%s  \u{00D7}%s  (%s)",
				entry.pet.rarity,
				formatMultiplier(entry.pet.mult * (entry.shiny and SHINY_BONUS or 1)),
				capDef.name
			)
			if entry.shiny then
				subline = "\u{2728} SHINY  \u{2022}  " .. subline
			end
			table.insert(batch, {
				emoji = entry.pet.emoji,
				name = entry.shiny and ("Shiny " .. entry.pet.name) or entry.pet.name,
				rarity = entry.pet.rarity,
				subline = subline,
			})
		end
	end
	for _, entry in ipairs(rolled) do
		if not entry.autoDel and #equippedPets < getMaxEquipped() then
			local key = entry.shiny and shinyKey(entry.pet.name) or entry.pet.name
			equipOne(key)
		end
	end

	if #batch > 0 then
		hatchQueue = { batch }
	end
	saveData(snapshotForSave())

	if autoDelCount > 0 then
		local sample = rolled[1].pet
		local base = autoDelCount == n
				and string.format("\u{1F5D1}\u{FE0F} Auto-deleted %dx (%s)", autoDelCount, sample.rarity)
			or string.format("\u{1F5D1}\u{FE0F} Auto-deleted %d / %d", autoDelCount, n)
		if autoDelRefundGems > 0 then
			base = base .. string.format("  +%s \u{1F48E}", formatNumber(autoDelRefundGems))
		end
		showNotification(base, rarityColors[sample.rarity] or Color3.fromRGB(120, 40, 50))
	end
	-- v39: always surface the latest hatch popup (overwrites any prior one).
	if #hatchQueue > 0 then
		showNextHatchPopup()
	end
	-- Live-update the inventory grid so new pets pop in behind the result popup.
	if InvOverlay.Visible then
		rebuildInventory()
	end
	updateLabels()
end

