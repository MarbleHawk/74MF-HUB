function FX.gemsFromHatch(eggCost, rarity)
	-- v50: Divine added as the new top-tier 💎 multiplier; old Variant kept for
	-- back-compat with saves rolled before v50.
	local rm = ({
		Common = 1,
		Uncommon = 1.35,
		Rare = 1.9,
		Epic = 2.75,
		Legendary = 4.6,
		Mythic = 9.5,
		Divine = 16,
		Variant = 12,
	})[rarity] or 1
	local c = math.max(1, tonumber(eggCost) or 1)
	-- v42: hatch 💎 income — sublinear in egg cost so late eggs pay enough to
	-- afford the next gem upgrade tier without making early hatches trivial.
	local raw = (c ^ 0.32) * 0.18 * rm
	return math.max(1, math.floor(raw))
