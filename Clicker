local function craftAllShinies()
	if invDeleteSelectMode then
		return
	end
	local totalCrafted = 0
	local keys = {}
	for k in pairs(inventory) do
		table.insert(keys, k)
	end
	for _, baseKey in ipairs(keys) do
		if not isShinyKey(baseKey) and petByName[baseKey] then
			local t = invEnsure(baseKey)
			if t and t.c >= SHINY_MERGE then
				local n = math.floor(t.c / SHINY_MERGE)
				if n > 0 then
					t.c = t.c - n * SHINY_MERGE
					if t.c <= 0 then
						inventory[baseKey] = nil
					end
					local shinyEntry = invGetOrCreate(shinyKey(baseKey))
					shinyEntry.c = shinyEntry.c + n
					totalCrafted = totalCrafted + n
				end
			end
		end
	end
	if totalCrafted <= 0 then
		showNotification(
			"Nothing to craft (need ×" .. SHINY_MERGE .. " normals per shiny).",
			Color3.fromRGB(160, 160, 180)
		)
		return
	end
	sanitizeEquippedFromInventory()
	saveData(snapshotForSave())
	rebuildInventory()
	updateLabels()
	showNotification(
		string.format("\u{2728} Crafted %d shiny pet%s", totalCrafted, totalCrafted == 1 and "" or "s"),
		Color3.fromRGB(255, 220, 120)
	)
end

