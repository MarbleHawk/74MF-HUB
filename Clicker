-- v42: auto-rebirth buys ONE specific bulk tier whenever it's affordable. The
-- tier is whichever rebirth-card chip the player has flipped green
-- (`autoRebirthSelectedAmount`); only one chip is green at a time. The 0.4 s
-- throttle keeps an over-eager player from saving 100×/s when clicks come in
-- bursts.
FX.lastAutoRebirthTick = 0
local function tryAutoRebirth()
	if not autoRebirthUnlocked or not maxRebirthUnlocked then
		return
	end
	local cap = autoRebirthSelectedAmount
	if not cap or cap <= 0 then
		return
	end
	local cost = getBulkCost(cap)
	if clicks < cost then
		return
	end
	local now = os.clock()
	if now - FX.lastAutoRebirthTick < 0.4 then
		return
	end
	FX.lastAutoRebirthTick = now
	clicks = 0
	rebirths = rebirths + cap
	local gemEach = getRebirthGemBonusEachAfterBulk(rebirths)
	local gemGain = cap * gemEach
	gems = gems + gemGain
	lifetimeGems = lifetimeGems + gemGain
	multiplier = getRebirthMultiplier()
	saveData(snapshotForSave())
	updateLabels()
end

-- Token-based loop. We bump the token whenever auto-click toggles or the speed changes,
-- so the running loop sees a stale token and exits while a new one starts in its place.
-- v26: removed per-tick batching. With the floor now at 0.01s the effective rate is
-- bounded by the task.wait scheduler (~60-100Hz) which is plenty fast and keeps the UI
-- from getting flooded with ripples/particles.
FX.autoClickToken = 0
local function runAutoClickLoop(token)
	while autoClickEnabled and token == FX.autoClickToken do
		-- autoMode = true → throttled ripple, no particles or click bounce.
		performClick(false, true)
		tryAutoRebirth()
		task.wait(getAutoClickInterval())
	end
end
restartAutoClickLoop = function()
	FX.autoClickToken = FX.autoClickToken + 1
	if autoClickEnabled then
		local myToken = FX.autoClickToken
		task.spawn(function()
			runAutoClickLoop(myToken)
		end)
	end
end

task.spawn(function()
	while true do
		task.wait(0.5)
		tryAutoRebirth()
	end
end)

