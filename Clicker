				if can3 ~= cache.can3 or areaUnlockChanged then
					ui.hatchBtn3x.BackgroundColor3 = can3 and Color3.fromRGB(180, 90, 220) or Color3.fromRGB(50, 28, 60)
					ui.hatchBtn3x.TextColor3 = can3 and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 130, 200)
					ui.hatchBtn3x.Text = "3x"
					cache.can3 = can3
				end
			end

			if ui.hatchBtn5x and FX.fiveHatchUnlocked then
