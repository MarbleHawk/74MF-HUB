-- v30: Pet circle layout (rebuilt only when equipped pets change) holds one entry per
-- visible slot { slot=, baseAngle= }. The slow rotation ticker just adds an offset to
-- baseAngle and reapplies positions, so layout work stays out of the per-frame path.
-- petCircleAngleOffset is in radians and wraps every full turn.
FX.petCircleLayout = {}
FX.petCircleAngleOffset = 0
FX.PET_CIRCLE_RADIUS = 150
-- Click button center is at (0.5, 0, 0.5, 20) in GameFrame space (button position
-- 0.5 -100 / 0.5 -80, size 200×200 ⇒ center +100/+100 → (0.5, 0, 0.5, 20)).
function FX.applyPetCirclePositions()
	local r = FX.PET_CIRCLE_RADIUS
	for _, e in ipairs(FX.petCircleLayout) do
		local angle = -math.pi / 2 + e.baseAngle + FX.petCircleAngleOffset
		local dx = math.cos(angle) * r
		local dy = math.sin(angle) * r
		e.slot.Position = UDim2.new(0.5, math.floor(dx - 22), 0.5, 20 + math.floor(dy - 22))
	end
end
function FX.refreshPetCircle()
	local holder = FX.petCircleHolder
	local slots = FX.petCircleSlots
	if not holder or not slots then
		return
	end
	-- Always reset the layout; we'll repopulate it for the circle mode below.
	FX.petCircleLayout = {}
	if FX.petDisplayMode ~= "circle" then
		holder.Visible = false
		for _, s in ipairs(slots) do
			s.Visible = false
			s:SetAttribute("petKey", nil)
		end
		return
	end
	holder.Visible = true
	local equipped = {}
	local cap = getMaxEquipped()
	for i = 1, cap do
		local key = equippedPets[i]
		if key then
			table.insert(equipped, key)
		end
	end
	local count = #equipped
	for i = 1, FX.EQ_CAP do
		local s = slots[i]
		if i <= count then
			local key = equipped[i]
			local pet = petByName[baseNameFromKey(key)]
			local shinyOn = isShinyKey(key)
			if pet then
				s.Text = pet.emoji
				s.TextColor3 = rarityColors[pet.rarity]
				s.BackgroundColor3 = shinyOn and Color3.fromRGB(70, 58, 22) or Color3.fromRGB(35, 28, 65)
				s.Visible = true
				-- v30: stash the equipped-pet key so the hover tooltip can look up
				-- pet stats without re-deriving the slot index.
				s:SetAttribute("petKey", key)
				table.insert(FX.petCircleLayout, {
					slot = s,
					baseAngle = (i - 1) * (2 * math.pi / count),
				})
			else
				s.Visible = false
				s:SetAttribute("petKey", nil)
			end
		else
			s.Visible = false
			s:SetAttribute("petKey", nil)
		end
	end
	FX.applyPetCirclePositions()
end

local function refreshEquippedBar()
	-- v28: when "circle" display mode is active, the bar is hidden and pets float
	-- around the click button instead.
	if FX.petDisplayMode == "circle" then
		EquippedBar.Visible = false
		FX.refreshPetCircle()
		return
	end
	EquippedBar.Visible = isOpen
	FX.refreshPetCircle()
	local cap = getMaxEquipped()
	for i = 1, FX.EQ_CAP do
		local lbl = equippedSlotLabels[i]
		lbl.Visible = i <= cap
		local key = equippedPets[i]
		if i <= cap and key then
			local pet = petByName[baseNameFromKey(key)]
			local shinyOn = isShinyKey(key)
			if pet then
				lbl.Text = pet.emoji
				lbl.TextColor3 = rarityColors[pet.rarity]
				lbl.BackgroundColor3 = shinyOn and Color3.fromRGB(70, 58, 22) or Color3.fromRGB(35, 28, 65)
				-- v30: tooltip lookup key.
				lbl:SetAttribute("petKey", key)
