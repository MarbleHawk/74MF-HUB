FX.maxRebirthFloatBtn.MouseButton1Click:Connect(function()
	if not maxRebirthUnlocked then
		return
	end
	local N = getMaxAffordableRebirths()
	if N <= 0 then
		return
	end

	rebirths = rebirths + N
	clicks = 0 -- rebirth always resets clicks to 0
	local gemEach = getRebirthGemBonusEachAfterBulk(rebirths)
	local gemGain = N * gemEach
	gems = gems + gemGain
	lifetimeGems = lifetimeGems + gemGain
	multiplier = getRebirthMultiplier()
	saveData(snapshotForSave())
	if showNotification then
		showNotification(
			string.format("♾️ Max rebirth: +%s rebirth%s, +%s 💎", formatNumber(N), N == 1 and "" or "s", formatNumber(gemGain)),
			Color3.fromRGB(150, 80, 220)
		)
	end
	updateLabels()
end)
FX.maxRebirthFloatBtn.MouseEnter:Connect(function()
	FX.maxRebirthFloatBtn.BackgroundColor3 = Color3.fromRGB(150, 80, 230)
end)
FX.maxRebirthFloatBtn.MouseLeave:Connect(function()
	FX.maxRebirthFloatBtn.BackgroundColor3 = Color3.fromRGB(120, 60, 200)
end)

