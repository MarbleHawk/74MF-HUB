-- v37: Leaderboards. Four categories (clicks / eggs / power / rebirths). The
-- backend is intentionally a thin stub: FX.httpRequest() prefers whichever
-- request global the host environment exposes (Roblox HttpService is restricted
-- to server scripts, so executor environments commonly expose a `request` global
-- under various names). FX.fetchLeaderboard / FX.submitLeaderboardScore POST/GET
-- to the URL in FX.LEADERBOARD_URL — currently a placeholder you'll point at
-- your Railway deployment later. Until that URL is set, FX.showLeaderboard just
-- renders the local stat as a single-row "preview" so the UI is fully wired up.
do
	-- TODO: Replace with your Railway deployment URL once the bot is online.
	-- Expected endpoints:
	--   GET  <URL>/leaderboard/<category>      -> { entries = { {name,score}, ... } }
	--   POST <URL>/submit                      <- { name, category, score }
	FX.LEADERBOARD_URL = FX.LEADERBOARD_URL or "https://clicker-lb-production.up.railway.app"

	-- Try every common executor http function in turn. Roblox's own HttpService
	-- isn't available from LocalScripts, so we ONLY succeed under an executor.
	-- Returns (ok, body_or_err). `body_or_err` is the response body string on ok.
	function FX.httpRequest(opts)
		local g = getfenv(0)
		local fn = rawget(g, "http_request") or rawget(g, "request")
		if not fn then
			local syn = rawget(g, "syn")
			if type(syn) == "table" then
				fn = syn.request
			end
		end
		if not fn then
			local http = rawget(g, "http")
			if type(http) == "table" then
				fn = http.request
			end
		end
		if type(fn) ~= "function" then
			return false, "no http function in environment"
		end
		local ok, res = pcall(fn, opts)
		if not ok then
			return false, tostring(res)
		end
		if type(res) == "table" and res.Body then
			return true, res.Body
		end
		return true, tostring(res)
	end

	function FX.submitLeaderboardScore(category, score)
		if FX.LEADERBOARD_URL == "" then
			return false, "no url"
		end
		local name = "player"
		local ok, dn = pcall(function()
			return LocalPlayer.DisplayName
		end)
		if ok and dn and dn ~= "" then
			name = dn
		end
		local payload = string.format(
			'{"name":%q,"category":%q,"score":%s}',
			name,
			category,
			tostring(score)
		)
		return FX.httpRequest({
			Url = FX.LEADERBOARD_URL .. "/submit",
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = payload,
		})
	end

	function FX.fetchLeaderboard(category, callback)
		if FX.LEADERBOARD_URL == "" then
			callback(false, nil)
			return
		end
		task.spawn(function()
			local ok, body = FX.httpRequest({
				Url = FX.LEADERBOARD_URL .. "/leaderboard/" .. category,
				Method = "GET",
			})
			callback(ok, body)
		end)
	end

	-- Pull the player's local value for `category` so we can show a preview row
	-- while the backend isn't wired up yet.
	local function localValueFor(category)
		if category == "clicks" then
			return lifetimeClicks or clicks or 0
		elseif category == "eggs" then
			return eggsHatched or 0
		elseif category == "power" then
			local m = (getTotalClickMultiplier and getTotalClickMultiplier()) or 1
			return m
		elseif category == "rebirths" then
			return rebirths or 0
		end
		return 0
	end

	function FX.showLeaderboard(categoryKey, displayName, titleLabel, bodyLabel)
		titleLabel.Text = "\u{1F3C6} Top " .. displayName
		bodyLabel.Text = "Loading..."
		-- Try to fetch live results. If the URL is unset OR the request fails,
		-- fall back to a single "your score" preview row so the UI looks alive.
		FX.fetchLeaderboard(categoryKey, function(ok, body)
			if ok and body and #body > 0 then
				-- Quick & dirty: show raw body. Once you wire up the bot you can
				-- replace this with proper JSON decoding + row rendering.
				bodyLabel.Text = body
				return
			end
			local val = localValueFor(categoryKey)
			local pname = "you"
			local nok, dn = pcall(function()
				return LocalPlayer.DisplayName
			end)
			if nok and dn and dn ~= "" then
				pname = dn
			end
			bodyLabel.Text = string.format(
				"#1  %s  —  %s\n\n(Could not reach leaderboard server — check your executor supports HTTP requests.)",
				pname,
				formatNumber(math.floor(val))
			)
		end)
	end
end

