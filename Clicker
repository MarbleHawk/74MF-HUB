function updateLabels()
	multiplier = getRebirthMultiplier()
	local petM = getEquippedPetMultiplier()
	local totalM = getTotalClickMultiplier()
	if totalM > highestClickPower then
		highestClickPower = totalM
	end

	if refreshStatsPanel then
