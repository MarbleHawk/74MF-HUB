local function _recycleSlot(slot)
	if _inv.conns[slot] then
		for _, c in ipairs(_inv.conns[slot]) do
			c:Disconnect()
		end
		_inv.conns[slot] = nil
	end
	-- Only pool proper slot Frames (those with our named children).
	if slot:IsA("Frame") and slot:FindFirstChild("TrashBtn") then
		slot.Visible = false
		slot.Parent = nil
		table.insert(_inv.pool, slot)
	else
		slot:Destroy()
	end
end

