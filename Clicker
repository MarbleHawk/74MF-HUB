-- v29: Hatch popup queue holds *batches*. A 1x hatch pushes a batch with one entry; a
-- 3x hatch pushes a batch with up to three entries (one per non-auto-deleted pet).
-- When a batch is shown we populate left / center / right popups simultaneously so a
-- triple hatch literally shows three side-by-side egg-open GUIs. Only the center popup
-- has the OK button — clicking it dismisses all three and advances to the next batch.
local hatchQueue = {}
local function applyToPopup(emojiLbl, nameLbl, rarityLbl, entry)
	emojiLbl.Text = entry.emoji
	nameLbl.Text = entry.name
	nameLbl.TextColor3 = rarityColors[entry.rarity] or Color3.fromRGB(255, 255, 255)
	rarityLbl.Text = entry.subline
	rarityLbl.TextColor3 = rarityColors[entry.rarity] or Color3.fromRGB(200, 200, 200)
end
local function showNextHatchPopup()
	local sides = FX.hatchSidePopups
	local function hideAllSides()
		if sides then
			sides.left.frame.Visible = false
			sides.right.frame.Visible = false
			sides.left2.frame.Visible = false
			sides.right2.frame.Visible = false
		end
	end
	local batch = table.remove(hatchQueue, 1)
	if not batch then
		HatchPopup.Visible = false
		hideAllSides()
		return
	end
	local n = #batch
	-- v34: assign batch entries into the visible popup slots, packed left → right
	-- around the center. Layouts:
	--   1: [c]              2: [l c]            3: [l c r]
	--   4: [l2 l c r]       5: [l2 l c r r2]
	local left2Pet, leftPet, centerPet, rightPet, right2Pet
	if n == 5 then
		left2Pet, leftPet, centerPet, rightPet, right2Pet = batch[1], batch[2], batch[3], batch[4], batch[5]
	elseif n == 4 then
		left2Pet, leftPet, centerPet, rightPet = batch[1], batch[2], batch[3], batch[4]
	elseif n == 3 then
		leftPet, centerPet, rightPet = batch[1], batch[2], batch[3]
	elseif n == 2 then
		leftPet, centerPet = batch[1], batch[2]
	else
		centerPet = batch[1]
	end
	applyToPopup(HatchResultEmoji, HatchResultName, HatchResultRarity, centerPet)
	HatchPopup.Visible = true
	if sides then
		local function setSide(s, pet)
			if pet then
				applyToPopup(s.emoji, s.name, s.rarity, pet)
				s.frame.Visible = true
			else
				s.frame.Visible = false
			end
		end
		setSide(sides.left, leftPet)
		setSide(sides.right, rightPet)
		setSide(sides.left2, left2Pet)
		setSide(sides.right2, right2Pet)
	end
end
