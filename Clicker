local function shinyKey(baseName)
	return baseName .. SHINY_SUFFIX
end

local function isShinyKey(key)
	if type(key) ~= "string" then
		return false
	end
	local n = #SHINY_SUFFIX
	return #key > n and string.sub(key, -n) == SHINY_SUFFIX
end

local function baseNameFromKey(key)
	if isShinyKey(key) then
		return string.sub(key, 1, #key - #SHINY_SUFFIX)
	end
	return key
end

