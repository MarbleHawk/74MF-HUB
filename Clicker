		last = now
		if FX.petDisplayMode == "circle" and #FX.petCircleLayout > 0 then
			FX.petCircleAngleOffset = (FX.petCircleAngleOffset + dt * 0.4) % TWO_PI
			FX.applyPetCirclePositions()
		end
	end
end)

