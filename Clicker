local function deleteAllUnequipped()
	-- Tally how many of each invKey are currently equipped so we leave that many
	-- behind. Anything beyond the equipped count gets removed. v51: skip locked.
	local keep = {}
	for _, k in ipairs(equippedPets) do
		keep[k] = (keep[k] or 0) + 1
	end
	local removed = 0
	local totalRefund = 0
	for invKey, _ in pairs(inventory) do
		if not invLockedPets[invKey] then
			local own = invCount(invKey)
			local keepN = keep[invKey] or 0
			if own > keepN then
				local rm = own - keepN
				removed = removed + rm
				local pet = petByName[baseNameFromKey(invKey)]
				if pet and pet.eggCost then
					totalRefund = totalRefund + math.floor(pet.eggCost * 0.5) * rm
				end
				local tt = invEnsure(invKey)
				if tt then
					tt.c = keepN
					if tt.c <= 0 then
						inventory[invKey] = nil
					end
				end
			end
		end
	end
	if totalRefund > 0 then
		clicks = clicks + totalRefund
		lifetimeClicks = lifetimeClicks + totalRefund
	end
	sanitizeEquippedFromInventory()
	saveData(snapshotForSave())
	rebuildInventory()
	updateLabels()
	if showNotification then
		local msg = removed > 0
				and string.format(
					"\u{1F5D1}\u{FE0F} Deleted %d pet%s  +%s clicks",
					removed, removed == 1 and "" or "s",
					formatNumber(totalRefund)
				)
			or "No unequipped pets to delete"
		showNotification(
			msg,
			removed > 0 and Color3.fromRGB(220, 80, 90) or Color3.fromRGB(220, 160, 80)
		)
	end
end

local function equipOne(petName)
	if #equippedPets >= getMaxEquipped() then
		return
	end
	local owned = invCount(petName)
	if countEquippedOf(petName) >= owned then
		return
	end
	table.insert(equippedPets, petName)
	refreshEquippedBar()
end

