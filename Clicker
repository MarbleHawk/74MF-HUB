	return math.floor(FX.COOLDOWN_BASE_GEMS * (FX.COOLDOWN_MULTI ^ FX.cooldownBought))
end
function FX.getEggRemainingCooldown(_eggId)
	local cd = FX.getEggCooldown()
	if cd <= 0 then
		return 0
	end
	local last = FX.lastHatchTick or 0
	if last <= 0 then
		return 0
	end
	local elapsed = os.clock() - last
	if elapsed >= cd then
		return 0
	end
	return cd - elapsed
end

