			local has3 = FX.tripleHatchUnlocked == true
			local has5 = FX.fiveHatchUnlocked == true
			ui.hatchBtn3x.Visible = has3
			ui.hatchBtn5x.Visible = has5
			if has5 and has3 then
				ui.hatchBtn5x.Position = UDim2.new(1, -44, 0, 0)
				ui.hatchBtn3x.Position = UDim2.new(1, -92, 0, 0)
				ui.hatchBtn.Size = UDim2.new(1, -96, 1, 0)
