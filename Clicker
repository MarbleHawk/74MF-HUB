	-- v50: Divine added as a togglable auto-delete tier (sits above Mythic).
	local AUTO_DELETE_RARITIES = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Divine" }

	local function setAutoDelete(eggId, rarity, value)
		if not autoDeleteRules[eggId] then
			autoDeleteRules[eggId] = {}
		end
		autoDeleteRules[eggId][rarity] = value and true or nil
	end
	local function setAutoDeleteAllEggs(rarity, value)
		for _, def in ipairs(EGG_DEFS) do
			setAutoDelete(def.id, rarity, value)
		end
	end
	local function aggregateAutoDeleteState(rarity)
		local on, total = 0, 0
		for _, def in ipairs(EGG_DEFS) do
			total = total + 1
			if shouldAutoDelete(def.id, rarity) then
				on = on + 1
			end
		end
		if on == 0 then
			return "none"
		end
		if on == total then
