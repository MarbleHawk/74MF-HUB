-- v44: area refresh + unlock helpers live on AREAS (no chunk locals).
-- v45: diff-cached so updateLabels() (called on every click) doesn't repaint
-- 33 area headers worth of properties every frame. Each header now stores a
-- _cache table that tracks (state, gemCostKey, canClick, canGem) and only
-- writes Roblox properties when one of those actually changes. The gem cost
-- itself is cached against `rebirths` so the closed-form math only runs when
-- the player's rebirth count changes (or the cache hasn't been primed yet).
-- v46: color constants live on AREAS too so we add zero chunk locals.
AREAS.COL_CLICK_BUY = Color3.fromRGB(60, 120, 200)
AREAS.COL_CLICK_NO = Color3.fromRGB(40, 40, 55)
AREAS.COL_GEM_BUY = Color3.fromRGB(120, 70, 190)
AREAS.COL_GEM_NO = Color3.fromRGB(40, 40, 55)

function AREAS.refresh()
	for a = 1, AREAS.NUM do
		local hdr = AREAS.headerUI[a]
		if hdr then
			local cache = hdr._cache
			if not cache then
				cache = { state = nil, rebirthsForGem = -1, gCost = 0, canC = nil, canG = nil }
				hdr._cache = cache
			end
			local unlocked = AREAS.unlocked[a] == true
			local state
			if a == 1 then
				state = "starter"
			elseif unlocked then
				state = "unlocked"
			else
				state = "locked"
			end

			if cache.state ~= state then
				cache.state = state
				if state == "starter" then
					hdr.lockedLabel.Visible = false
					hdr.unlockedLabel.Visible = true
					hdr.priceLabel.Visible = false
					hdr.btnRow.Visible = false
				elseif state == "unlocked" then
					hdr.lockedLabel.Visible = false
					hdr.unlockedLabel.Visible = true
					hdr.unlockedLabel.Text = "✓ Unlocked"
					hdr.priceLabel.Visible = false
					hdr.btnRow.Visible = false
				else
					hdr.lockedLabel.Visible = true
					hdr.unlockedLabel.Visible = false
					hdr.priceLabel.Visible = true
					hdr.btnRow.Visible = true
				end
				-- Force button-color recompute after a state change.
				cache.canC = nil
				cache.canG = nil
			end

			if state == "locked" then
				local cCost = AREAS.UNLOCK_CLICKS[a] or 0
				if cache.rebirthsForGem ~= rebirths then
					cache.rebirthsForGem = rebirths
					cache.gCost = AREAS.gemsFromRebirthSpending(cCost, rebirths)
					hdr.priceLabel.Text = string.format(
						"Cost: %s clicks  or  %s 💎 (gems if you spent those clicks on rebirths)",
						formatNumber(cCost),
						formatNumber(cache.gCost)
					)
					cache.canC = nil
					cache.canG = nil
				end
				local canC = clicks >= cCost
				if canC ~= cache.canC then
					cache.canC = canC
					hdr.clickBtn.BackgroundColor3 = canC and AREAS.COL_CLICK_BUY or AREAS.COL_CLICK_NO
				end
				local canG = gems >= cache.gCost
				if canG ~= cache.canG then
					cache.canG = canG
					hdr.gemBtn.BackgroundColor3 = canG and AREAS.COL_GEM_BUY or AREAS.COL_GEM_NO
				end
			end
		end
	end
end

function AREAS.tryUnlock(areaIdx, payWithGems)
	if areaIdx <= 1 or AREAS.unlocked[areaIdx] then
		return
	end
	local cCost = AREAS.UNLOCK_CLICKS[areaIdx] or 0
	if cCost <= 0 then
		return
	end
	if payWithGems then
		local gCost = AREAS.gemsFromRebirthSpending(cCost, rebirths)
		if gems < gCost then
			showNotification("Need " .. formatNumber(gCost) .. " 💎 gems", Color3.fromRGB(120, 50, 70))
			return
		end
		spendGems(gCost)
	else
		if clicks < cCost then
			showNotification("Need " .. formatNumber(cCost) .. " clicks", Color3.fromRGB(120, 50, 70))
			return
		end
		clicks = clicks - cCost
	end
	AREAS.unlocked[areaIdx] = true
	saveData(snapshotForSave())
	AREAS.refresh()
	updateLabels()
	showNotification(
		(AREAS.NAMES[areaIdx] or ("Area " .. areaIdx)) .. " unlocked!",
		Color3.fromRGB(90, 200, 120)
	)
end

