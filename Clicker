	makeButton("\u{2728} Make Equipped Pets Shiny", Color3.fromRGB(220, 180, 80), function()
		-- Spend nothing — just convert the equipped slots to their shiny variant.
		-- Useful for screenshotting the shiny FX without grinding 5x of each.
		for slot = 1, FX.EQ_CAP do
			local key = equippedPets[slot]
			if key then
				local base = baseNameFromKey(key)
				local shinyKey = base .. "|shiny"
				equippedPets[slot] = shinyKey
				invGetOrCreate(shinyKey).c = math.max(invGetOrCreate(shinyKey).c, 1)
			end
		end
		saveData(snapshotForSave())
		refreshEquippedBar()
		updateLabels()
		showNotification("\u{1F451} Equipped pets are now shiny", Color3.fromRGB(220, 180, 80))
	end)

