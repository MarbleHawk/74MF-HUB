	local function makeButton(labelText, color, onClick)
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(1, 0, 0, 34)
		btn.BackgroundColor3 = color
		btn.BorderSizePixel = 0
		btn.Text = labelText
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		btn.TextSize = 13
		btn.Font = Enum.Font.GothamBold
		btn.ZIndex = 901
		btn.Parent = body
		local bc = Instance.new("UICorner")
		bc.CornerRadius = UDim.new(0, 6)
		bc.Parent = btn
		btn.MouseButton1Click:Connect(onClick)
		return btn
	end

	local function parseAmount(s)
		-- Accepts plain numbers and scientific notation (1e9, 1.5e12, etc).
		local n = tonumber(s)
		return n
	end

	-- Rows -----------------------------------------------------------------------
	makeRow("\u{1F5B1}\u{FE0F} Set Clicks", "e.g. 1e15", function(v)
		local n = parseAmount(v)
		if n and n >= 0 then
			clicks = math.floor(n)
			lifetimeClicks = math.max(lifetimeClicks, clicks)
			saveData(snapshotForSave())
			updateLabels()
			showNotification("\u{1F451} Clicks set to " .. formatNumber(clicks), Color3.fromRGB(220, 180, 80))
		end
	end)
	makeRow("\u{1F501} Set Rebirths", "e.g. 100", function(v)
		local n = parseAmount(v)
		if n and n >= 0 then
			rebirths = math.floor(n)
			saveData(snapshotForSave())
			updateLabels()
			showNotification("\u{1F451} Rebirths set to " .. formatNumber(rebirths), Color3.fromRGB(220, 180, 80))
		end
	end)
	makeRow("\u{1F48E} Set Gems", "e.g. 1e12", function(v)
		local n = parseAmount(v)
		if n and n >= 0 then
			gems = math.floor(n)
			lifetimeGems = math.max(lifetimeGems, gems)
			saveData(snapshotForSave())
			updateLabels()
			showNotification("\u{1F451} Gems set to " .. formatNumber(gems), Color3.fromRGB(220, 180, 80))
		end
	end)
	makeRow("\u{1F43E} Give Pet (name)", "e.g. Cat", function(v)
		local query = string.lower(string.gsub(v or "", "^%s+", ""):gsub("%s+$", ""))
		if query == "" then
			return
		end
		-- Case-insensitive name match against petByName.
		local found = nil
		for name, pet in pairs(petByName) do
			if string.lower(name) == query then
				found = pet
				break
			end
		end
		if not found then
			showNotification("\u{1F451} Pet not found: " .. v, Color3.fromRGB(160, 60, 70))
			return
		end
		local ht = invGetOrCreate(found.name)
		ht.c = ht.c + 1
		saveData(snapshotForSave())
		if InvOverlay.Visible then
			rebuildInventory()
		end
		updateLabels()
		showNotification("\u{1F451} Gave +1 " .. found.name, Color3.fromRGB(220, 180, 80))
	end)

	makeButton("\u{1F4E6} Give One of Every Pet", Color3.fromRGB(60, 130, 200), function()
		local added = 0
		for _, pet in pairs(petByName) do
			local ht = invGetOrCreate(pet.name)
			if ht.c < 1 then
				ht.c = 1
				added = added + 1
			end
		end
		saveData(snapshotForSave())
		if InvOverlay.Visible then
			rebuildInventory()
		end
		updateLabels()
		showNotification("\u{1F451} Added " .. added .. " pets", Color3.fromRGB(220, 180, 80))
	end)

	makeButton("\u{1F511} Unlock All Upgrades", Color3.fromRGB(100, 80, 200), function()
		FX.tripleHatchUnlocked = true
		FX.fiveHatchUnlocked = true
		FX.auroraLevel = FX.AURORA_MAX
		FX.cooldownBought = FX.COOLDOWN_MAX
		FX.shinyBought = FX.SHINY_MAX
		autoClickUpgradesBought = FX.AC_MAX
		maxRebirthUnlocked = true
		autoRebirthUnlocked = true
		-- Buy-out the bulk-rebirth + storage + equip slots so the upgrade panel
		-- reads "MAX" everywhere.
		for _ = 1, 30 do
			storageUpgradesBought = storageUpgradesBought + 1
		end
		for _ = 1, FX.EQ_CAP - FX.EQ_BASE do
			equipSlotsBought = equipSlotsBought + 1
		end
		FX.refreshHatchButtons()
		if FX.refreshClickButtonTheme then
			FX.refreshClickButtonTheme()
		end
		saveData(snapshotForSave())
		updateLabels()
		refreshEquippedBar()
		restartAutoClickLoop()
		showNotification("\u{1F451} All upgrades unlocked", Color3.fromRGB(220, 180, 80))
	end)

	makeButton("\u{1F5DD}\u{FE0F} Unlock All Areas", Color3.fromRGB(70, 140, 160), function()
