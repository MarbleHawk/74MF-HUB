-- AUTO-DELETE: state, helpers, and shared modal GUI (per-egg + master).
-- Hatching an egg whose rolled rarity is flagged in autoDeleteRules deletes the
-- pet immediately instead of adding it to inventory. shouldAutoDelete + openAutoDeleteGui
-- are the only chunk-level locals exposed; everything else lives inside the IIFE to
-- stay under Luau's 200 locals-per-chunk cap.
-- =====================
local function shouldAutoDelete(eggId, rarity)
	local row = autoDeleteRules[eggId]
	return row ~= nil and row[rarity] == true
end
local openAutoDeleteGui = function(_) end

