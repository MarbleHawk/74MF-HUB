		powerLbl.Text = "Power \u{00D7}" .. formatMultiplier(effectiveMultForPetName(key))
		shinyTag.Text = shinyOn and "\u{2728} Shiny pet" or ""

		-- Position the tooltip just above the slot, clamped inside GameFrame so it
		-- never spills off the visible area (top edge → flip below the slot).
		local sap = slot.AbsolutePosition
		local sas = slot.AbsoluteSize
		local gp = GameFrame.AbsolutePosition
		local gs = GameFrame.AbsoluteSize
		local relX = sap.X + sas.X / 2 - gp.X - TIP_W / 2
