	end

	CounterLabel.Text = "🖱️ " .. formatNumber(clicks)
	RebirthCounterLabel.Text = "🔁 " .. formatNumber(rebirths)
	GemsLabel.Text = "💎 " .. formatNumber(gems)
	-- Subline shows the click breakdown so the top stats row stays compact and
	-- doesn't wrap when rebirths / pet mult / clicks all hit huge numbers.
	-- v35: tack on aurora multi at the end of the breakdown only when the player has
	-- bought one — keeps the line compact for early-game players who haven't seen
	-- auroras yet.
	local auroraM = FX.getAuroraMultiplier()
	local auroraSuffix = (auroraM > 1) and ("  \u{00D7} \u{00D7}" .. formatMultiplier(auroraM) .. " aurora") or ""
	CPSLabel.Text = "+"
		.. formatMultiplier(totalM)
		.. " / click  ·  ×"
		.. formatMultiplier(multiplier)
		.. " reb · ×"
		.. formatMultiplier(petM)
		.. " pets"
		.. auroraSuffix

	local petsOwned = getTotalPetCount()
	local cap = getPetStorageCap()
	if PetStorageLabel then
		PetStorageLabel.Text = string.format("📦 Storage: %s/%s", formatNumber(petsOwned), formatNumber(cap))
		PetStorageLabel.TextColor3 = petsOwned >= cap and Color3.fromRGB(255, 120, 120) or Color3.fromRGB(140, 220, 255)
	end

	-- v42 perf: hoist the global cooldown out of the loop (every egg shares it).
	-- Diff-cache the per-egg button state on `ui._cache` so we only rewrite text /
	-- colors when the affordability bool, the cooldown bucket, or the unlock flag
	-- actually changes — the old loop did 75 × 3 prop writes EVERY click.
	local sharedCdLeft = FX.getEggRemainingCooldown(nil)
	-- v49: drop the bucket cache for the *timer* text. The old `cdBucket =
	-- floor(cdLeft * 10)` got stuck on the final tenth-of-a-second (bucket = 0
	-- for cdLeft in [0, 0.1)) and froze the button label at "(0.1s)" even
	-- though the cooldown was actually still ticking down. Now while cooldown
	-- is active we rewrite the timer text every frame; the diff cache still
	-- skips repaints once cooldown ends.
	local cdActive = sharedCdLeft > 0
	for _, def in ipairs(EGG_DEFS) do
		local ui = eggUI[def.id]
		if ui then
			local cache = ui._cache
			if not cache then
				cache = {}
				ui._cache = cache
			end
			local areaOk = AREAS.unlocked[def.areaIndex] == true
			local areaUnlockChanged = (cache.areaOk ~= areaOk)
			if areaUnlockChanged then
				ui.card.BackgroundTransparency = areaOk and 0 or 0.22
			end
			-- While cooldown is ticking, always refresh the timer label so the
			-- countdown reaches zero smoothly. Outside cooldown the diff cache
			-- below skips redundant text writes.
			if cdActive then
				ui.hatchBtn.Text = string.format("%s Hatch %s  (%.1fs)", def.emoji, def.name, sharedCdLeft)
			end
			local can1 = areaOk and clicks >= def.cost and petsOwned < cap and not cdActive
			if can1 ~= cache.can1 or cache.cdActive ~= cdActive or areaUnlockChanged then
				ui.hatchBtn.BackgroundColor3 = can1 and def.btnColor or Color3.fromRGB(35, 35, 55)
				ui.hatchBtn.TextColor3 = can1 and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(100, 100, 130)
				if not cdActive then
					if not areaOk then
						ui.hatchBtn.Text = "🔒 Area locked"
					else
						ui.hatchBtn.Text = def.emoji .. " Hatch " .. def.name
					end
				end
				cache.can1 = can1
				cache.cdActive = cdActive
			end

			if ui.hatchBtn3x and FX.tripleHatchUnlocked then
				local cost3 = def.cost * 3
