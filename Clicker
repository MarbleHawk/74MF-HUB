local function invEnsure(key)
	local v = inventory[key]
	if v == nil then
		return nil
	end
	if type(v) == "number" then
		inventory[key] = { c = v, lv = 1, xp = 0 }
		return inventory[key]
	end
	if type(v) ~= "table" then
		inventory[key] = { c = 0, lv = 1, xp = 0 }
		return inventory[key]
	end
	local t = v
	t.c = math.max(0, math.floor(tonumber(t.c) or tonumber(t.count) or 0))
	t.lv = math.max(1, math.floor(tonumber(t.lv) or tonumber(t.level) or 1))
	t.xp = math.max(0, math.floor(tonumber(t.xp) or 0))
	t.shiny = nil -- legacy field retired; shiny variants are separate keys now
	return t
end

local function invGetOrCreate(key)
	if not inventory[key] then
		inventory[key] = { c = 0, lv = 1, xp = 0 }
	end
	return invEnsure(key)
end

local function invCount(name)
	local t = invEnsure(name)
	return t and t.c or 0
end

local function normalizeAllInventory()
	for n in pairs(inventory) do
		invEnsure(n)
	end
end

local function grantEquippedPetXpFromClick()
	for _, key in ipairs(equippedPets) do
		local t = invEnsure(key)
		if t and t.c > 0 then
			t.xp = t.xp + PET_XP_PER_CLICK
			local need = xpToNextLevel(t.lv)
			while t.xp >= need do
				t.xp = t.xp - need
				t.lv = t.lv + 1
				need = xpToNextLevel(t.lv)
			end
		end
	end
end

local function effectiveMultForPetName(key)
	local base = baseNameFromKey(key)
	local p = petByName[base]
	local t = invEnsure(key)
	if not p or not t or t.c <= 0 then
		return 1
	end
	local lvlPart = 1 + (t.lv - 1) * PET_LVL_STEP
	local shinyPart = isShinyKey(key) and SHINY_BONUS or 1
	-- v50: pet contribution tripled (0.4 → 1.2) — pets were under-pulling vs.
	-- rebirths in the late-game ladder. Pairs with the new Divine rarity sitting
	-- above Mythic on the multiplier curve.
	return p.mult * lvlPart * shinyPart * 1.2
end

