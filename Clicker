				ui.hatchBtn3x.Position = UDim2.new(1, -44, 0, 0)
				ui.hatchBtn.Size = UDim2.new(1, -48, 1, 0)
			elseif has5 then
				-- Edge case (5x bought without 3x — admin grant or save edit). Show 5x in
				-- the right slot.
				ui.hatchBtn5x.Position = UDim2.new(1, -44, 0, 0)
				ui.hatchBtn.Size = UDim2.new(1, -48, 1, 0)
			else
				ui.hatchBtn.Size = UDim2.new(1, 0, 1, 0)
