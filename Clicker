		-- Empty everything except equipped slots; useful for testing storage caps
		-- and inventory rebuilds without nuking the rest of the save.
		inventory = {}
		for slot = 1, FX.EQ_CAP do
			equippedPets[slot] = nil
		end
		normalizeAllInventory()
		saveData(snapshotForSave())
		if InvOverlay.Visible then
			rebuildInventory()
		end
		refreshEquippedBar()
		updateLabels()
		showNotification("\u{1F451} Inventory wiped", Color3.fromRGB(220, 180, 80))
	end)

	makeButton("\u{1F3C6} Submit My Stats to Leaderboard", Color3.fromRGB(220, 180, 80), function()
		if FX.LEADERBOARD_URL == "" then
			showNotification("\u{1F3C6} Set FX.LEADERBOARD_URL first", Color3.fromRGB(160, 60, 70))
			return
		end
		FX.submitLeaderboardScore("clicks", lifetimeClicks)
		FX.submitLeaderboardScore("eggs", eggsHatched)
		FX.submitLeaderboardScore("power", getTotalClickMultiplier())
		FX.submitLeaderboardScore("rebirths", rebirths)
		showNotification("\u{1F3C6} Submitted to leaderboard", Color3.fromRGB(220, 180, 80))
	end)

