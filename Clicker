applyLayoutForSidebar = function(animate)
	local barW = computeEquipBarWidth()

	-- Hard rule: NOTHING central moves or resizes when the sidebar toggles. The sidebar
	-- itself grows / shrinks / slides off-screen in place; the toggle arrows on its left
	-- edge stay just inside the viewport so the user can always step the cycle.
	local sz, pos = sidebarStateProps(sidebarState)
	local sidebarProps = { Size = sz, Position = pos }
	EquippedBar.Size = UDim2.new(0, barW, 0, 36)
	EquippedBar.Position = UDim2.new(0.5, 0, 1, -90)

	-- v42: Grow button is now bidirectional — at state < 2 it points inward (◀)
	-- and grows; at state 2 (already biggest) it FLIPS to ▶ and shrinks back to
	-- "small", so there is no dead-end button.
	-- The Hide button (▶) is the "drop straight to hidden" shortcut and only
	-- appears at the "small" state where it's the unambiguous "fully hide" path.
	if SidebarGrowBtn then
		if sidebarState < 2 then
			SidebarGrowBtn.Text = "\u{25C0}"
		else
			SidebarGrowBtn.Text = "\u{25B6}"
