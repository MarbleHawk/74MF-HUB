-- Gems equivalent to spending `clickBudget` on sequential single rebirths starting at
-- `startRebirthCount` (fair budget model: no full rebirth reset, just cost + gem each).
-- v44: hung off AREAS instead of a chunk-level local to stay under Luau's
-- 200-local-per-chunk limit.
-- v45: closed-form math instead of an inner loop. Late-area click budgets sit
-- around 10^48-10^50, which made the per-rebirth loop want to execute ~10^24
-- iterations and freeze the script. We now derive n (the number of rebirths
-- afforded by `budget`) from the quadratic
--     S(n) = n*B + P*n*R + P*n*(n-1)/2  <= budget
-- and we sum gem(R) = 1 + min(10, floor(R^0.18)) over n consecutive rebirths
-- via 10 pre-computed bucket boundaries (since floor(R^0.18) only takes the
-- values 1..10 once R >= 1).
-- v46: ALL helper state for this lives on AREAS (boundary table + ensure
-- function) so we don't burn extra chunk locals.
function AREAS._ensureGemBdry()
	if AREAS._gemBdry then
		return AREAS._gemBdry
	end
	local t = {}
	for v = 1, 11 do
		local raw = v ^ (1 / 0.18)
		local r = math.ceil(raw)
		-- v48: bounded refinement — math.ceil + at most ±4 ULPs is plenty.
		for _ = 1, 4 do
			if r > 0 and r ^ 0.18 < v then
				r = r + 1
			else
				break
			end
		end
		for _ = 1, 4 do
			if r > 1 and (r - 1) ^ 0.18 >= v then
				r = r - 1
			else
				break
			end
		end
		t[v] = r
	end
	AREAS._gemBdry = t
	return t
end

function AREAS.gemsFromRebirthSpending(clickBudget, startRebirthCount)
	local budget = math.max(0, tonumber(clickBudget) or 0)
	if budget <= 0 then
		return 0
	end
	local R = math.max(0, math.floor(tonumber(startRebirthCount) or 0))
	local B = FX.RB_BASE
	local P = FX.RB_PER
	-- v48: pure closed-form, ZERO loops over n. v47's exponential-hi + binary
	-- search froze the script: once n grew past 2^53 (~9e15), doubles can't
	-- represent consecutive integers, so `hi = mid - 1` stopped making progress
	-- and the binary search ran until Roblox killed the script at 30 s. Late
	-- areas have budgets ~10^48, which yields n ~10^23 — way past the FP integer
	-- range. The quadratic formula gives n directly; being off by 1 at that
	-- scale changes the displayed gem total by ~11 out of 10^25, which is below
	-- one ULP of the display anyway.
	--
	-- S(n) = n*B + P*n*R + P*n*(n-1)/2 <= budget
	--   <=> P*n^2 + (2B + 2PR - P)*n - 2*budget <= 0
	--   =>  n = floor( (-coeff + sqrt(coeff^2 + 8*P*budget)) / (2P) )
	local coeff = 2 * B + 2 * P * R - P
	local disc = coeff * coeff + 8 * P * budget
	if disc < 0 then
		return 0
	end
	local n = math.floor((-coeff + math.sqrt(disc)) / (2 * P))
	if n <= 0 then
		return 0
	end
	local lo, hi = R + 1, R + n
	-- gem(r) = 1 + min(10, floor(r^0.18)). Base +1 per rebirth, then add the
	-- min(10, floor) part in 10 closed-form bucket chunks.
	local edges = AREAS._ensureGemBdry()
	local total = hi - lo + 1
	for v = 1, 9 do
		local vlo = math.max(lo, edges[v])
		local vhi = math.min(hi, edges[v + 1] - 1)
		if vhi >= vlo then
			total = total + v * (vhi - vlo + 1)
		end
	end
	local cap_lo = math.max(lo, edges[10])
	if hi >= cap_lo then
		total = total + 10 * (hi - cap_lo + 1)
	end
	return math.floor(total + 0.5)
end
local function getBulkCost(amount)
	if amount <= 0 then
		return 0
	end
	local R = rebirths
	local B = FX.RB_BASE
	local P = FX.RB_PER
	return amount * B + P * amount * R + P * amount * (amount - 1) * 0.5
end

-- Quadratic max-affordable for sum_i=0..n-1 (B + P*(R+i)).
local function getMaxAffordableRebirths()
	local R = rebirths
	local B = FX.RB_BASE
	local P = FX.RB_PER
	local C = clicks
	if P <= 0 then
		return 0
	end
	local a = P * 0.5
	local b = B + P * R - P * 0.5
	local disc = b * b + 2 * P * C
	if disc < 0 then
		return 0
	end
	local n = math.floor((math.sqrt(disc) - b) / (2 * a))
	local function totalCost(n0)
		if n0 <= 0 then
			return 0
		end
		return n0 * B + P * n0 * R + P * n0 * (n0 - 1) * 0.5
	end
	local guard = 0
	while n > 0 and totalCost(n) > C and guard < 128 do
		n = n - 1
		guard = guard + 1
	end
	guard = 0
	while totalCost(n + 1) <= C and guard < 128 do
		n = n + 1
		guard = guard + 1
	end
	if n < 0 then
		n = 0
	end
	return n
end
-- Short-scale suffixes: K (1e3) through qitg (1e108), one entry per ×1000 step.
-- v40: formatNumber uses log10 + tier indexing instead of scanning thresholds.
-- The old approach compared `n >= 1e48` etc. — IEEE doubles can't represent huge
-- integers exactly, so `n` can sit *below* the literal threshold while still being
-- "morally" in the next band. That made the loop latch onto an early suffix (e.g.
-- `dc`) while `n/divisor` exploded to 1e15+, and `%d` printed the full integer
-- before the suffix (`1092363304095967dc`). Tier from floor(log10(n)/3) stays
-- consistent with the float's magnitude class.
local NUMBER_ABBREV_ORDER = {
	"K",
	"M",
	"B",
	"T",
	"Qd",
	"Qn",
	"sx",
	"sp",
	"oc",
	"no",
	"dc",
	"ud",
	"dd",
	"td",
	"qad",
	"qid",
	"sxd",
	"spd",
	"ocd",
	"nod",
	"vg",
	"uvg",
	"dvg",
	"tvg",
	"qavg",
	"qivg",
	"sxvg",
	"spvg",
	"ocvg",
	"novg",
	"tg",
	"utg",
	"dtg",
	"ttg",
	"qatg",
	"qitg",
}

local function formatNumber(n)
	n = tonumber(n)
	if not n or n ~= n then
		return "0"
	end
	if n < 0 then
		return "-" .. formatNumber(-n)
	end
	if n < 1000 then
		return tostring(math.floor(n + 0.5))
	end
	-- log10 tier: [1e3,1e6)→1→K, [1e6,1e9)→2→M, …
	local log = math.log10(n)
	local tier = math.floor(log / 3)
	local maxTier = #NUMBER_ABBREV_ORDER
	tier = math.clamp(tier, 1, maxTier)
	local divisor = 10 ^ (tier * 3)
	local v = n / divisor
	-- Float cleanup: keep mantissa in [1, 1000) when possible.
	while tier < maxTier and v >= 1000 do
		tier = tier + 1
		divisor = divisor * 1000
		v = n / divisor
	end
	while tier > 1 and v < 1 do
		tier = tier - 1
		divisor = divisor / 1000
		v = n / divisor
	end
	-- v49: a value just below 1000 (e.g. 999.97 Qd) was getting formatted as
	-- "1000.0Qd" by %.1f instead of bumping into the next suffix as "1.00Qi".
	-- Pre-check the rounding boundary so we promote one tier before format.
	if v >= 999.95 and tier < maxTier then
		tier = tier + 1
		v = v / 1000
	end
	local suffix = NUMBER_ABBREV_ORDER[tier]
	if tier >= maxTier and v >= 1000 then
		return string.format("%.2e", n)
	end
	-- Never use %d for v≥1000 — if we land here, use fixed decimals instead.
	if v < 10 then
		return string.format("%.2f%s", v, suffix)
	elseif v < 100 then
		return string.format("%.1f%s", v, suffix)
	else
		-- v in [100, 1000): use one decimal — %.0f can round 999.6 → "1000"
		-- and read like a tier slip.
		return string.format("%.1f%s", v, suffix)
	end
end

-- Round for UI (avoid huge decimals from pet product)
local function formatMultiplier(m)
	if m >= 100 then
		return formatNumber(m)
	end
	return string.format("%.2fx", m)
end

-- v29: human-readable playtime. Sub-minute → "Xs"; sub-hour → "Mm Ss"; sub-day → "Hh Mm";
-- multi-day → "Dd Hh".
local function formatPlaytime(s)
	s = math.max(0, math.floor(tonumber(s) or 0))
	if s < 60 then
		return s .. "s"
	end
	local m = math.floor(s / 60)
	if m < 60 then
		return string.format("%dm %ds", m, s % 60)
	end
	local h = math.floor(m / 60)
	if h < 24 then
		return string.format("%dh %dm", h, m % 60)
	end
	local d = math.floor(h / 24)
	return string.format("%dd %dh", d, h % 24)
end

local function countEquippedOf(petName)
	local c = 0
	for _, n in ipairs(equippedPets) do
