-- =====================
-- CLICK FLARE: PARTICLES + RIPPLE
-- =====================
local function spawnParticle(basePos, customText, isBig)
	-- v37: settings gate. If the player has turned off click particles entirely,
	-- bail before allocating any instances so the click path is essentially free.
	if not FX.particlesEnabled then
		return
	end
	local size = isBig and 56 or 44
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(0, size, 0, size)
	local angle = math.random() * math.pi * 2
	local radius = math.random(0, 18)
	-- Convert absolute screen coords to GameFrame-local coords (topbar offset).
	local gp = GameFrame.AbsolutePosition
	local startX = (basePos.X - gp.X) + math.cos(angle) * radius
	local startY = (basePos.Y - gp.Y) + math.sin(angle) * radius
	lbl.Position = UDim2.new(0, startX - size / 2, 0, startY - size / 2)
	lbl.BackgroundTransparency = 1
	-- v37: emoji palette + tint palette both come from the active aurora theme so
	-- once you ascend (e.g.) Spark, the floating particles switch to red-themed
	-- glyphs (🔥❤️🌹🍓...) AND red tints, not just retinted defaults.
	local theme = FX.getAuroraTheme()
	local emojis = theme.emojis
	lbl.Text = customText or emojis[math.random(1, #emojis)]
	lbl.TextSize = isBig and math.random(28, 38) or math.random(20, 30)
	local tints = theme.tints
	lbl.TextColor3 = tints[math.random(1, #tints)]
	lbl.TextStrokeTransparency = 0.4
	lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	lbl.Font = Enum.Font.GothamBold
	lbl.Rotation = math.random(-25, 25)
	lbl.ZIndex = 500
	lbl.Parent = GameFrame

	-- Drift mostly upward with some horizontal scatter.
	local driftX = math.random(-90, 90)
	local driftY = -math.random(90, 160)
	local endX = startX + driftX
	local endY = startY + driftY
	local endRot = lbl.Rotation + math.random(-90, 90)
	local endSize = size + math.random(8, 22)

	-- Phase 1: pop in (scale up briefly)
	local popTween = TweenService:Create(
		lbl,
		TweenInfo.new(0.08, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		{ Size = UDim2.new(0, size + 10, 0, size + 10) }
	)
	popTween:Play()

	-- Phase 2: drift up + fade out + grow slightly + spin a touch
	task.delay(0.06, function()
		local drift = TweenService:Create(
			lbl,
			TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{
				Position = UDim2.new(0, endX - endSize / 2, 0, endY - endSize / 2),
				Size = UDim2.new(0, endSize, 0, endSize),
				TextTransparency = 1,
				TextStrokeTransparency = 1,
				Rotation = endRot,
			}
		)
		drift:Play()
		drift.Completed:Connect(function()
			lbl:Destroy()
		end)
	end)
end

-- Big themed ripple. Lives at ZIndex 50 (below every UI element parented to GameFrame),
-- so it never covers buttons / labels. Grows from 40px to roughly half-screen and
-- fades to fully transparent on the way. v36: ripple + stroke colors read from the
-- current aurora theme each frame so the ripple recolors instantly when an aurora
-- ascends.
local function spawnRipple(basePos)
	-- Settings gate: user can disable ripples entirely from the settings panel. We bail
	-- before allocating any instances so the click path is essentially free when off.
	if not FX.ripplesEnabled then
		return
	end
	local theme = FX.getAuroraTheme()
	local startSize = 40
	local viewport = GameFrame.AbsoluteSize
	-- Half-screen-ish: take the bigger viewport dimension, hit ~55% of it.
	local endSize = math.max(420, math.floor(math.max(viewport.X, viewport.Y) * 0.55))
	-- basePos is absolute screen coords; convert to GameFrame-local coords so the
	-- ripple is centered exactly on the click button (the topbar offset was making
	-- it appear above the button).
	local gp = GameFrame.AbsolutePosition
	local cx = basePos.X - gp.X
	local cy = basePos.Y - gp.Y
	local ripple = Instance.new("Frame")
	ripple.Size = UDim2.new(0, startSize, 0, startSize)
	ripple.Position = UDim2.new(0, cx - startSize / 2, 0, cy - startSize / 2)
	ripple.BackgroundColor3 = theme.ripple
	ripple.BackgroundTransparency = 0.35
	ripple.BorderSizePixel = 0
	ripple.ZIndex = 50
	ripple.Parent = GameFrame
	local rc = Instance.new("UICorner")
	rc.CornerRadius = UDim.new(1, 0)
	rc.Parent = ripple
	local stroke = Instance.new("UIStroke")
	stroke.Color = theme.stroke
	stroke.Thickness = 4
	stroke.Transparency = 0.1
	stroke.Parent = ripple

	local info = TweenInfo.new(0.95, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local tween = TweenService:Create(ripple, info, {
		Size = UDim2.new(0, endSize, 0, endSize),
		Position = UDim2.new(0, cx - endSize / 2, 0, cy - endSize / 2),
		BackgroundTransparency = 1,
	})
	tween:Play()
	TweenService:Create(stroke, info, { Transparency = 1, Thickness = 1 }):Play()
	tween.Completed:Connect(function()
		ripple:Destroy()
	end)
end

