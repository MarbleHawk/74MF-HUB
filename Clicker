-- Equip Best: clears current loadout and equips the highest base-mult pets,
-- ignoring level entirely (a level-10 pet is treated as if it were level 1, so the
-- comparison is purely on the pet's base type plus shiny bonus). Respects
-- inventory counts so we never equip more copies than the player owns.
local function equipBest()
	if invDeleteSelectMode then
		return
	end
	local maxEq = getMaxEquipped()
	-- Build a flat list of pet "instances" (one entry per owned copy) and rank by
	-- base mult × shiny bonus. Greedy pick of the top maxEq is optimal for an
	-- additive multiplier model.
	local instances = {}
	for invKey, _ in pairs(inventory) do
		local pet = petByName[baseNameFromKey(invKey)]
		local count = invCount(invKey)
		if pet and count > 0 then
			local shinyBonus = isShinyKey(invKey) and SHINY_BONUS or 1
			local baseMult = pet.mult * shinyBonus
			for _ = 1, count do
				table.insert(instances, { key = invKey, mult = baseMult })
			end
		end
	end
	table.sort(instances, function(a, b)
		return a.mult > b.mult
	end)

	equippedPets = {}
	local cap = math.min(maxEq, #instances)
	for i = 1, cap do
		table.insert(equippedPets, instances[i].key)
	end

	refreshEquippedBar()
	if InvOverlay.Visible then
		rebuildInventory()
	end
	saveData(snapshotForSave())
	updateLabels()

	if showNotification then
		showNotification(
			cap > 0 and string.format("Auto-equipped %d pet%s", cap, cap == 1 and "" or "s")
				or "No pets to equip!",
			cap > 0 and Color3.fromRGB(80, 200, 110) or Color3.fromRGB(220, 160, 80)
		)
	end
end

