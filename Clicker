function FX.getShinyChance()
	local lvl = math.clamp(FX.shinyBought, 0, FX.SHINY_MAX)
	return FX.SHINY_BASE_CHANCE + (FX.SHINY_MAX_CHANCE - FX.SHINY_BASE_CHANCE) * (lvl / FX.SHINY_MAX)
end
