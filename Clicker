local function rollPetFromList(list)
	-- Floating-point roll over the list's total chance (chances no longer have to be ints).
	-- This lets us hand out 0.1% Mythic and 0.06% Variant odds without rounding loss.
	local total = 0
	for _, pet in ipairs(list) do
		total = total + pet.chance
	end
	local roll = math.random() * total
	local cumulative = 0
	for _, pet in ipairs(list) do
		cumulative = cumulative + pet.chance
		if roll <= cumulative then
			return pet
		end
	end
	return list[#list]
end

