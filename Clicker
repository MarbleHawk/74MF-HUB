-- Pets are ADDITIVE: each equipped pet's effective multiplier is summed,
-- then that sum is multiplied against the rebirth multiplier.
-- (Without any pets equipped we fall back to 1x so clicks still count.)
local function getEquippedPetMultiplier()
	if #equippedPets == 0 then
		return 1
	end
	local sum = 0
	for _, name in ipairs(equippedPets) do
		sum = sum + effectiveMultForPetName(name)
	end
	if sum < 1 then
		return 1
	end
	return sum
end

local function getRebirthMultiplier()
	if rebirths <= 0 then
		return 1
	end
	return math.max(1, rebirths ^ FX.RB_EXP)
end

local function getTotalClickMultiplier()
	-- v35: aurora multiplier is applied AFTER (rebirth × pets) so it scales the
	-- existing power. With no aurora purchased it returns 1 → identity.
	return getRebirthMultiplier() * getEquippedPetMultiplier() * FX.getAuroraMultiplier()
end

-- Sanitize equipped list vs inventory and slot cap (after load)
local function sanitizeEquippedFromInventory()
	local newEq = {}
	local cap = getMaxEquipped()
	for _, key in ipairs(equippedPets) do
		if #newEq >= cap then
			break
		end
		local p = petByName[baseNameFromKey(key)]
		if p then
			local have = invCount(key)
			local already = 0
			for _, n in ipairs(newEq) do
				if n == key then
					already = already + 1
				end
			end
			if already < have then
				table.insert(newEq, key)
			end
		end
	end
	equippedPets = newEq
end

