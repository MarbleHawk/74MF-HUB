	-- v34: three-state reset flow. Idle → countdown (cancel-on-click) → confirm-ready.
	-- A click while the countdown is still ticking *cancels* the reset (button text
	-- snaps back to "Reset All Data"). Once the 5s countdown finishes, the button
	-- enters "Confirm Reset!" state and only THEN does a click actually wipe the save.
	-- States: 0 = idle, 1 = counting (click cancels), 2 = ready (click resets).
	local resetState = 0
	local resetTokenLocal = 0
	local function setResetIdle()
		resetState = 0
		resetBtn.Text = "\u{1F5D1}\u{FE0F} Reset All Data"
		resetBtn.BackgroundColor3 = Color3.fromRGB(150, 40, 60)
	end
	resetBtn.MouseButton1Click:Connect(function()
		if resetState == 0 then
			resetTokenLocal = resetTokenLocal + 1
			local myToken = resetTokenLocal
			resetState = 1
			resetBtn.BackgroundColor3 = Color3.fromRGB(220, 140, 60)
			task.spawn(function()
				for remaining = 5, 1, -1 do
					if myToken ~= resetTokenLocal or resetState ~= 1 then
						return
					end
					resetBtn.Text = string.format("\u{1F501} Click to Cancel (%ds)", remaining)
					task.wait(1)
				end
				if myToken == resetTokenLocal and resetState == 1 then
					resetState = 2
					resetBtn.Text = "\u{26A0}\u{FE0F} Confirm Reset!"
					resetBtn.BackgroundColor3 = Color3.fromRGB(220, 80, 90)
					task.wait(5)
					if myToken == resetTokenLocal and resetState == 2 then
						setResetIdle()
					end
				end
			end)
			return
		end
		if resetState == 1 then
			resetTokenLocal = resetTokenLocal + 1
			setResetIdle()
			return
		end
		setResetIdle()
		if FX.performFullReset then
			FX.performFullReset()
		end
	end)

