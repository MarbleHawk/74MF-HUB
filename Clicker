	end
	return FX.COOLDOWN_BASE_S * (1 - lvl / FX.COOLDOWN_MAX)
end
function FX.getCooldownUpgradeCost()
	if FX.cooldownBought >= FX.COOLDOWN_MAX then
		return nil
