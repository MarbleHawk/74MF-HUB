		FX.auroraLevel = 0
		if FX.refreshClickButtonTheme then
			FX.refreshClickButtonTheme()
		end
		saveData(snapshotForSave())
		updateLabels()
		showNotification("\u{1F451} Aurora reset", Color3.fromRGB(220, 180, 80))
	end)

