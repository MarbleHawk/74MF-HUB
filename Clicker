-- Single source of truth for "the click happened". Used by both the click button and
-- the auto-clicker loop so both paths get the same gain math, particles, and ripple.
FX.lastSaveTick = os.clock()
-- Throttle for the auto-clicker's ripple so we don't spawn 100 ripples/sec at max upgrade.
FX.lastAutoRippleTick = 0
-- v42: throttle the heavy updateLabels() call from the auto-click hot path.
-- updateLabels paints every visible card (rebirth tiers, upgrade prices, aurora
-- cards, equipped bar) and is the single biggest CPU cost in the game. Capping
-- it at ~25 Hz on the auto path stops 100 cps from melting the UI thread; the
-- click counter / rebirths / gems labels are still bumped directly so the
-- top-of-screen feedback stays instant.
FX.lastFullUiTick = 0
FX.FULL_UI_INTERVAL = 0.04

local function performClick(showFlare, autoMode)
	local gain = math.floor(getTotalClickMultiplier() + 0.5)
	if gain < 1 then
		gain = 1
	end
	clicks = clicks + gain
	lifetimeClicks = lifetimeClicks + gain
	grantEquippedPetXpFromClick()
	-- Auto-clicker can fire 100x/sec; throttle disk writes so we don't thrash the file.
	local now = os.clock()
	if now - FX.lastSaveTick > 0.5 then
		saveData(snapshotForSave())
		FX.lastSaveTick = now
	end
	if autoMode and now - FX.lastFullUiTick < FX.FULL_UI_INTERVAL then
		-- Light path: just bump the always-visible counter labels so the player
		-- sees the click counter ticking. Skip the heavy refresh until the
		-- throttle window expires.
		CounterLabel.Text = "🖱️ " .. formatNumber(clicks)
	else
		FX.lastFullUiTick = now
		updateLabels()
	end
	if showFlare then
		task.spawn(animateClick)
		local btnAbsPos = ClickButton.AbsolutePosition
		local btnAbsSize = ClickButton.AbsoluteSize
		local origin = Vector2.new(btnAbsPos.X + btnAbsSize.X / 2, btnAbsPos.Y + btnAbsSize.Y / 2)
		spawnRipple(origin)
		spawnParticle(origin, "+" .. formatNumber(gain), true)
		local count = math.random(6, 9)
		for i = 1, count do
			local capI = i
			task.delay((capI - 1) * 0.018, function()
				spawnParticle(origin)
			end)
		end
	elseif autoMode then
		-- Auto-clicker: just a ripple, throttled so high-tier auto speeds don't
		-- drown the screen in ripples (the clicker can fire ~100x/sec at max).
		-- v37: also gated on the dedicated auto-click-FX toggle so players can keep
		-- manual ripples on but quiet the auto-clicker.
		if not FX.autoClickFxEnabled then
			return
		end
		local now = os.clock()
		if now - FX.lastAutoRippleTick >= 0.18 then
			FX.lastAutoRippleTick = now
			local btnAbsPos = ClickButton.AbsolutePosition
			local btnAbsSize = ClickButton.AbsoluteSize
			local origin = Vector2.new(btnAbsPos.X + btnAbsSize.X / 2, btnAbsPos.Y + btnAbsSize.Y / 2)
			spawnRipple(origin)
		end
	end
end

